# ==============================================================================
# CODEFORGE PRO — PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to .env or inject these variables into your hosting platform
# (e.g. Railway, Render, Fly.io, AWS EC2, or Docker).
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3001
WS_PORT=3002

# Allowed CORS Origins (comma-separated, leave blank for same-origin single-port deployment)
ALLOWED_ORIGINS=https://codeforge.yourdomain.com

# Database Connection
# Option 1: SQLite (Single-instance VPS or persistent volume)
DATABASE_URL="file:./prisma/dev.db"

# Option 2: PostgreSQL (Recommended for cloud PaaS like Railway, Render, Supabase)
# DATABASE_URL="postgresql://user:password@hostname:5432/codeforge?schema=public&sslmode=prefer"

# Security & Authentication
# Generate a secure 64-char random hex key using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_key_in_production
JWT_EXPIRES_IN=7d

# AI Intelligence Suite (Groq LPU High-Speed Engine + Google Gemini Fallback)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=

# Code Sandbox Engine
# Self-hosted Piston container or private endpoint
PISTON_BASE_URL=https://emkc.org/api/v2/piston

# Compiler Constraints & Limits
COMPILER_CONNECT_TIMEOUT=5000
COMPILER_READ_TIMEOUT=15000
COMPILER_MAX_SOURCE_SIZE=102400
COMPILER_MAX_FILES=20
COMPILER_MAX_STDIN_SIZE=51200
COMPILER_MAX_CONCURRENT_JOBS=10

# Rate Limiting (Protection against denial of service)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# Firebase Authentication (Frontend Web App Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (Backend Token Verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

